<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- v0.1.29+10 HOTFIX: HTTPS calls to bz5-bridge.
         CloudSyncService was added in v0.1.28+1 and BridgeDiagService is
         planned (P1.1) — both make outbound HTTPS to carbridge.neardo.work.
         Without this permission the Dart http client raises:
           ClientException with SocketException:
             Failed host lookup: 'carbridge.neardo.work'
             OS Error: No address associated with hostname, errno = 7
         Browsers and other apps work because they ship with INTERNET
         declared. Field-discovered 2026-05-23 when the user first tried
         the setup flow on the head unit.

         ACCESS_NETWORK_STATE lets the app inspect connectivity state
         (Wi-Fi vs cellular vs offline) without itself initiating any
         network traffic — useful for future "skip cloud sync when
         offline" optimisations and for a clearer "no network" UI hint
         in the Cloud backup status card. Declared now so we don't
         repeat the v0.1.28+1 omission pattern. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth permissions for Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Legacy Bluetooth for Android < 12 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <!-- v0.1.2: keep BLE/CPU alive during long polling sessions in-car.
         Required for stable monitoring on head units that aggressively
         throttle background apps. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v0.1.13: storage write for export-to-Downloads feature.
         WRITE_EXTERNAL_STORAGE is required on Android < 11 to write into
         the public /storage/emulated/0/Download/ folder so the file is
         visible to Toyota launcher's built-in 'Проводник' / file manager.
         android:maxSdkVersion="29" limits the permission to API 29 (Android 10)
         and below — on Android 11+ (scoped storage) the permission is gone
         and we rely on legacy storage opt-in below. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- v0.1.13: read permission for re-importing exports later (and on some
         OEM ROMs read is required to enumerate the Downloads folder).
         Same maxSdkVersion logic.

         v0.1.77+176: потолок поднят 29 → 32, и это ПРОБА С ИЗВЕСТНЫМ
         СТРУКТУРНЫМ ПОТОЛКОМ, а не ожидаемое решение. Наш targetSdk
         равен 35 (проверено в flutter.groovy тега 3.27.4; CI это нигде
         не переопределяет — grep targetSdk по .github/workflows пуст),
         поэтому requestLegacyExternalStorage ниже не действует вовсе, а
         при targetSdk >= 30 на устройстве API 32 это разрешение
         открывает через scoped storage только МЕДИА. APK не медиа —
         значит прочитать его File-API со съёмного тома снятием потолка
         НЕ ОТКРОЕТСЯ В ПРИНЦИПЕ. Объявление стоит здесь ровно затем,
         чтобы путь A1c был пробирован, а не предположен: правило «ни
         один путь не предполагать» уже дважды стоило дороже, чем
         лишняя строка манифеста. Побочная выгода того же прогона —
         проверить, оживают ли публичные Downloads, мёртвые с +166. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- v0.1.77+176: второй путь к файлу (A1b). Разрешение особое: одним
         объявлением не выдаётся, экран для него открывается из
         приложения — и этого экрана на прошивке может не оказаться
         ровно так же, как не оказалось экрана unknown-sources (поле
         29.07, ActivityNotFoundException). Поэтому оно НЕ является
         условием работы обозревателя: listApks деградирует к
         SAF-дереву, которое прав на хранилище не требует вообще. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- v0.1.27: BYD car framework access for native head-unit mode.
         These permissions only mean anything on real BZ5/BYD head units —
         on phones they're silently ignored by the system. The car-side
         provider auth permission is normal-level (granted at install).
         The BYDAUTO_*_COMMON and _GET permissions are dangerous/runtime —
         we declare a superset (both naming conventions) because CanDataCollect
         decompile showed BYD uses both styles inconsistently across domains;
         missing ones are just ignored by the system.
         The provider permission grants us access to the ContentProvider
         that bootstraps ICarPropertyService via the BinderProvider pattern. -->
    <uses-permission android:name="com.byd.car.server.PROVIDER" />
    <uses-permission android:name="android.permission.BYDAUTO_POWER_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_POWER_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_TYRE_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_LOCATION_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_DTC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHTS_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_DOORLOCK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_TIME_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_TEST_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_VERSION_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_VEHICLE_DATA_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_BIGDATA_COMMON" />
    <!-- v0.1.29+66: AC domain was the ONE missing _COMMON — field-confirmed
         2026-06-11: BYDAutoAcDevice.getInstance threw SecurityException
         "Neither user 10218 nor current process has android.permission.
         BYDAUTO_AC_COMMON" (HAL Test, registered 7/8). recon (uid 10163)
         declares it and its AC channel works; companion simply never did. -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON" />

    <!-- v0.1.26+14 field test on a real BZ5 (carserver 2.1.0-alpha10)
         revealed that the firmware has TWO-LAYER permission gating
         on at least Bodywork: getInstance() checks BYDAUTO_BODYWORK_COMMON,
         but the actual data-reading helper (getDataFlag, line 2201)
         checks BYDAUTO_BODYWORK_GET. Granting only _COMMON gets you
         past the constructor and into a deeper SecurityException with
         the _GET name in the message. We added 6 _GET variants in
         v0.1.27 (POWER/CHARGING/ENERGY/SPEED/GEARBOX/STATISTIC) but
         missed the other 12 domains. Now declaring all of them — the
         system silently ignores names that don't exist on this
         firmware, so adding extras is cheap and safe. -->
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_TYRE_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_LOCATION_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_DTC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHTS_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_DOORLOCK_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_TIME_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_TEST_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_VERSION_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_VEHICLE_DATA_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_BIGDATA_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_AC_GET" />

    <!-- v0.1.2: required="false" to allow install on devices that may not
         report BLE feature (e.g. some car head units with custom BT stacks).
         App will check BLE availability at runtime in connect screen. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- v0.1.2: explicit touchscreen=false allows install on head units
         with non-standard input drivers (faketouch, rotary, hard-key).
         App is touch-driven but does not strictly require it for install. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <!-- v0.1.56+155: autostart net (AutostartService, START_STICKY).
         FOREGROUND_SERVICE is a normal-level permission required since
         SDK 28 to call startForeground.

         v0.1.72+171: УТВЕРЖДЕНИЕ «boot-путь — доказанная стена» СНЯТО.
         Оно стояло здесь с +155 и стоило нам полутора месяцев: стена
         (recon p112/p113) действительно есть, но она вокруг запуска
         foreground-СЕРВИСА из boot-контекста, а не вокруг доставки
         самого broadcast'а. Ресиверный лог recon 28.07 показывает
         BOOT_COMPLETED, дошедший до приложения; из него ставится
         будильник, и уже из alarm-контекста startForegroundService
         разрешён. Поле того же дня: recon встаёт сам за 7–8 с после
         каждого пробуждения ГУ, companion не встаёт ни разу, и
         единственная разница между ними — этот ресивер.

         RECEIVE_BOOT_COMPLETED — доставка BOOT_COMPLETED.
         SCHEDULE_EXACT_ALARM — точный будильник; на Android 12 (у нас
         sdk=32) выдаётся автоматически по одному объявлению, но
         отзываем пользователем, поэтому код проверяет
         canScheduleExactAlarms() и пишет деградацию в маркер.
         USE_EXACT_ALARM — на будущее: с Android 14 автоматической
         выдачи SCHEDULE_EXACT_ALARM больше нет. Существует с API 33,
         на 32 просто игнорируется. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- v0.1.73+172: своя установка APK. Обновиться на ГУ иначе нечем —
         проводник APK не запускает, ADB нет, а SilentInstaller на
         существующий пакет отвечает 系统已安装 и засчитывает это в
         УСПЕХ, то есть установку не начинает. На телефоне тот же APK с
         той же подписью встаёт поверх, значит дело не в пакете.
         Разрешение — appop: объявления мало, владелец включает его
         руками, и экран для этого открывается из приложения. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="BZ5 Companion"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <!-- v0.1.13: requestLegacyExternalStorage="true" makes File API work
             against /storage/emulated/0/Download/ on Android 10 (API 29).
             This flag is ignored on Android 11+ (scoped storage is enforced)
             and on Android <10 (legacy was default). On Android 11+ the
             public Downloads write may fail and ExportService falls back to
             app-private external dir (Android/data/com.bz5companion/files/). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- v0.1.56+155: the autostart net. Not exported: armed only
             from our own Dart side via MethodChannel("bz5/autostart"),
             resurrected only by ActivityManager (START_STICKY). -->
        <service
            android:name=".AutostartService"
            android:exported="false" />
        <!-- v0.1.72+171: мост автозапуска. Рецепт recon p115, целиком.

             exported="true" обязателен: системные broadcast'ы
             доставляются только экспортированным ресиверам. Поверхность
             атаки нулевая — единственное, что ресивер умеет делать по
             чужой команде, это поднять НАШ же сервис, чего мы и хотим.

             Три системных действия: BOOT_COMPLETED (на этой прошивке
             приходит и при перезапуске фреймворка поверх живого ядра —
             лог recon показывает FIRED при uptime в сутки),
             QUICKBOOT_POWERON (быстрый старт) и MEDIA_MOUNTED со
             scheme=file (ГУ поднял хранилище). Повторный подъём
             безвреден и потому не защищается: onStartCommand
             идемпотентен. Поправка +174 — дубли БЫВАЮТ: поле 29.07
             дало 8 строк bridged: на 6 born:, потому что первый
             будильник успевает выстрелить (5–9 с) раньше, чем
             приходит второе системное действие (9–19 с).

             Четвёртое действие — собственное. Будильник приходит явным
             intent'ом и фильтра не требует, но у recon оно объявлено, а
             отклоняться от проверенного в поле рецепта ради косметики
             дороже: цена ошибки здесь — поездка. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.bz5companion.AUTOSTART_ALARM" />
            </intent-filter>
        </receiver>
        <!-- v0.1.73+172: провайдер одного файла — подготовленного APK.
             file:// установщику отдать нельзя с Android 7
             (FileUriExposedException), нужен content:// с временным
             грантом.

             ПОПРАВКА v0.1.77+176. Обоснование «androidx.core проверить
             локально нечем» БЫЛО НЕВЕРНО и снято здесь тем же разбором,
             что и в ApkFileProvider.kt в +173: share_plus, который стоит
             у нас в pubspec, объявляет ShareFileProvider как наследника
             androidx.core.content.FileProvider — значит androidx.core на
             classpath гарантированно, и риска сборки не было. Утверждение
             простояло в манифесте на четыре патча дольше, чем в коде,
             потому что гейт BJ5 читает только .kt. Настоящая причина
             оставить свой провайдер — она же и достаточная: штатный
             требует res/xml с описанием путей и обслуживает каталоги, а
             нам нужен РОВНО ОДИН файл. -->
        <!-- v0.1.77+176 §A2: приём APK через «поделиться». Если штатный
             проводник это умеет, файл придёт к нам в обход первой стены
             (ACTION_OPEN_DOCUMENT захвачен галереей BYD, которая
             перечисляет только изображения и видео).

             ОТДЕЛЬНАЯ activity, а НЕ фильтр на MainActivity: у главной
             taskAffinity="" и launchMode="singleTop", и менять её
             поверхность запуска ради приёма файла — риск, несоразмерный
             выгоде, она же лончер.

             exported="true" обязателен — иначе нас нет в списке «кому
             поделиться». Поверхность атаки: чужое приложение может
             положить нам в кэш свой файл под именем staged_update.apk.
             Установить его молча нельзя (диалог системного установщика
             показывает пакет и требует подтверждения), поэтому цена
             ограничена содержимым нашего же кэша.

             noHistory + excludeFromRecents + NoDisplay: активити
             стажирует файл и немедленно закрывается, своего UI у неё
             нет. -->
        <activity
            android:name=".StageActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <provider
            android:name=".ApkFileProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- v0.1.27: on Android 11+ (API 30+) package visibility is restricted.
             Without these <queries> entries, ContentResolver returns null for
             carserver's BinderProvider even with the right permission. -->
        <package android:name="com.byd.car.server" />
        <provider android:authorities="com.byd.car.server.provider.CarServiceProvider" />
        <!-- v0.1.29+100: car_status service-health provider (Status screen).
             Same Android 11+ package-visibility rule — without this entry
             ContentResolver.query() can return null even though the provider
             is exported and permission-free. Head-unit only; harmless on a
             phone where the authority does not resolve. -->
        <provider android:authorities="com.byd.carStatusProvider" />
        <!-- v0.1.73+172: без этих записей проба пути установки вернёт
             ПУСТО при полностью живом установщике — с Android 11
             queryIntentActivities и getPackageInfo фильтруются по
             видимости пакетов. Соврала бы она при этом в самую
             опасную сторону: «установщика нет, идея мертва». Тот же
             урок, что и с провайдером carserver в +100. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action
                android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
        <!-- v0.1.77+176: те же грабли видимости для НОВЫХ дверей.
             Без этих записей расширенная проба вернёт пустой список у
             живого экрана, и мы второй раз закроем как безнадёжное то,
             что просто не видно. OPEN_DOCUMENT_TREE здесь главный: это
             ДРУГОЕ действие, чем перехваченный галереей OPEN_DOCUMENT, и
             единственный путь, который на API 30+ для съёмных томов
             задуман работать. -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action
                android:name="android.settings.MANAGE_ALL_UNKNOWN_APP_SOURCES" />
        </intent>
        <intent>
            <action
                android:name="android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION" />
        </intent>
        <intent>
            <action
                android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SECURITY_SETTINGS" />
        </intent>
        <intent>
            <action
                android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.google.android.packageinstaller" />
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.documentsui" />
    </queries>
</manifest>
